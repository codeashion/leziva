# ==============================================================================
# LEZIVA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# NOTICE: Use placeholders only. Never commit real credentials to version control.
# ==============================================================================

# Application Runtime Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=LEZIVA

# Database (PostgreSQL 16)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://leziva_user:leziva_pass@localhost:5432/leziva_db?schema=public"
DIRECT_URL="postgresql://leziva_user:leziva_pass@localhost:5432/leziva_db?schema=public"

# Redis Cache, Rate Limiting & Background Queues
REDIS_URL="redis://localhost:6379"

# Session Security & Cryptography
# Generate a 32+ char secret: openssl rand -base64 32
AUTH_SECRET="dev-secret-super-safe-key-change-in-production"
SESSION_SECRET="dev-secret-super-safe-key-change-in-production"
SESSION_COOKIE_NAME="leziva_session"
SESSION_TTL_SECONDS=604800

# Transactional Email Service
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="smtp_placeholder_user"
SMTP_PASS="smtp_placeholder_pass"
EMAIL_FROM="LEZIVA Concierge <concierge@leziva.com>"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Logistics & Courier Partner (Velocity Shipping API)
VELOCITY_BASE_URL="https://shazam.velocity.in/"
VELOCITY_USERNAME="velocity_api_username_placeholder"
VELOCITY_PASSWORD="velocity_api_password_placeholder"
VELOCITY_WAREHOUSE_ID="WH_SURAT_001"
VELOCITY_PICKUP_LOCATION="LEZIVA Surat Atelier Warehouse"
VELOCITY_WAREHOUSE_PINCODE="395007"
VELOCITY_REQUEST_TIMEOUT_MS=15000

# Cloud Media Storage (S3 / Cloudflare R2 / AWS S3)
S3_BUCKET_NAME="leziva-fashion-media"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="s3_access_key_placeholder"
S3_SECRET_ACCESS_KEY="s3_secret_key_placeholder"
NEXT_PUBLIC_CDN_DOMAIN="https://cdn.leziva.com"
